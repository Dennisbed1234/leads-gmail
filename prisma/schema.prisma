generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  title       String?
  company     String?
  email       String?  @unique
  phone       String?
  address     String?
  industry    String?
  source      String   @default("SEC EDGAR")
  score       Int      @default(50)

  tags        String?

  notes       String?
  status      String   @default("NEW")

  cik         String?
  filingDate  String?
  filingType  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([company])
  @@index([status])
  @@index([source])
  @@index([cik])
  @@index([createdAt])
}

model Company {
  id          String   @id @default(cuid())
  cik         String   @unique
  name        String
  ticker      String?
  exchange    String?
  industry    String?
  description String?
  address     String?
  website     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([ticker])
}

// Outbox / sent monitor — events mirror Resend last_event style
model SentEmail {
  id          String    @id @default(cuid())
  toEmail     String
  toName      String?
  subject     String
  bodySnippet String?
  status      String    @default("SENT") // SENT | DELIVERED | OPENED | FAILED
  messageId   String?
  error       String?
  mode        String?
  isHtml      Boolean   @default(true)
  fromName    String?

  deliveredAt DateTime?
  openedAt    DateTime?
  openCount   Int       @default(0)
  lastEvent   String?   // sent | delivered | opened | clicked | failed

  createdAt   DateTime  @default(now())

  @@index([toEmail])
  @@index([status])
  @@index([createdAt])
}
