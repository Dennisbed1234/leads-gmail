generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  title       String?
  company     String?
  email       String?  @unique
  phone       String?
  address     String?
  industry    String?
  source      String   @default("SEC EDGAR")
  score       Int      @default(50)

  // Store tags as JSON string
  tags        String?

  notes       String?
  status      String   @default("NEW")

  // SEC-specific fields
  cik         String?
  filingDate  String?
  filingType  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([company])
  @@index([status])
  @@index([source])
  @@index([cik])
  @@index([createdAt])
}

model Company {
  id          String   @id @default(cuid())
  cik         String   @unique
  name        String
  ticker      String?
  exchange    String?
  industry    String?
  description String?
  address     String?
  website     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([ticker])
}
