# Copy to Vercel Environment Variables (or .env.local for local dev)
# NEVER commit real secrets.

# ===== REQUIRED =====

DATABASE_URL="postgresql://user:password@host:5432/leadbot?sslmode=require"

# SEC EDGAR User-Agent
SEC_USER_AGENT="CryptoByt (you@yourdomain.com)"

NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate-a-long-random-string-at-least-32-chars"

# ===== SMTP (company domain preferred over free Gmail) =====
#
# DELIVERABILITY (this is what actually fixes Mail-Tester / spam):
# 1. Send FROM your company domain (e.g. boa@bigoldalps.com), not a random Gmail
# 2. DNS on that domain MUST have:
#    - SPF   TXT  v=spf1 include:... ~all   (include your SMTP provider)
#    - DKIM  TXT  selector._domainkey      (from your SMTP / host)
#    - DMARC TXT  _dmarc  v=DMARC1; p=none; rua=mailto:you@domain.com
# 3. Test at https://www.mail-tester.com  (aim for 9/10+)
# 4. Warm up: 10–20/day first week, not 500
#
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="dennisbed1234@gmail.com"
SMTP_PASS="your-smtp-password"
# From address MUST be on the authenticated domain (DMARC alignment)
SMTP_FROM="boa@yourdomain.com"
SMTP_FROM_NAME="CryptoByt"
SMTP_REPLY_TO="CryptoByt@yourdomain.com"
# Return-Path / envelope — same domain as SMTP_FROM when possible
SMTP_ENVELOPE_FROM="CryptoByt@yourdomain.com"
# Optional HELO hostname matching your domain
SMTP_HELO="mail.yourdomain.com"
SMTP_UNSUBSCRIBE_URL="https://yourdomain.com/unsubscribe"
SMTP_SEND_DELAY_MS="3000"

HUNTER_API_KEY=""
