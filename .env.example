# Copy to Vercel Environment Variables (or .env.local for local dev)
# NEVER commit real secrets.

DATABASE_URL="postgresql://user:password@host:5432/leadbot?sslmode=require"

# REQUIRED in production — HTTP Basic Auth gate for the whole app
APP_GATE_USER="admin"
APP_GATE_PASSWORD="use-a-long-random-password"

SEC_USER_AGENT="CryptoByt (you@yourdomain.com)"

NEXTAUTH_URL="https://your-app.vercel.app"
APP_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate-a-long-random-string-at-least-32-chars"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="dennisbed1234@gmail.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="boa@yourdomain.com"
SMTP_FROM_NAME="CryptoByt"
SMTP_REPLY_TO="CryptoByt@yourdomain.com"
SMTP_ENVELOPE_FROM="CryptoByt@yourdomain.com"
SMTP_HELO="mail.yourdomain.com"
SMTP_UNSUBSCRIBE_URL="https://yourdomain.com/unsubscribe"

# Delay between each recipient (ms). Default in code is 150 (fast).
# 0 = as fast as possible | 2000 = slower / safer for warm-up
SMTP_SEND_DELAY_MS="150"
# Parallel SMTP connections (Gmail: 1–2 is safest)
SMTP_MAX_CONNECTIONS="2"

HUNTER_API_KEY=""
