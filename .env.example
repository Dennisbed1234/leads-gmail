# env.example
# Copy this file to .env.production and fill in your values

# Database (Required)
# Use Neon, Supabase, or Railway for PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/leadbot"

# Next.js (Required)
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="your-32-character-secret-here-minimum-32-characters"

# SEC EDGAR (Required - Free)
SEC_USER_AGENT="Your Company Name (your-email@example.com)"

# Optional: Email Verification
HUNTER_API_KEY="your-hunter-api-key"

# Optional: SMTP for Campaigns
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"