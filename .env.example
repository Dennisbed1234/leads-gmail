# Copy to Vercel Environment Variables (or .env.local for local dev)
# NEVER commit real secrets.

# ===== REQUIRED =====

# Database - MUST be PostgreSQL for Vercel (Neon, Supabase, Railway, etc.)
# SQLite will NOT work on Vercel serverless.
DATABASE_URL="postgresql://user:password@host:5432/leadbot?sslmode=require"

# SEC EDGAR requires a descriptive User-Agent with contact email
# Example: "YourAppName (yourname@yourdomain.com)"
SEC_USER_AGENT="BIG OLD ALPS (your-email@example.com)"

# Optional but recommended for NextAuth if you add auth later
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate-a-long-random-string-at-least-32-chars"

# ===== OPTIONAL =====

# Email verification services (not currently used in core flow)
HUNTER_API_KEY=""

# SMTP for campaign sending (Gmail App Password recommended)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="your-email@gmail.com"
# Display name in inbox — BIG OLD ALPS initials (not LeadBot)
SMTP_FROM_NAME="BOA"
# Optional reply-to (defaults to SMTP_FROM)
SMTP_REPLY_TO="your-email@gmail.com"
# Optional one-click unsubscribe URL (List-Unsubscribe header)
SMTP_UNSUBSCRIBE_URL="https://your-domain.com/unsubscribe"
# Base delay between sends in ms (jitter added automatically; default 4000)
SMTP_SEND_DELAY_MS="4000"
